{
  "popup": {
    "type": "dialog",
    "modal": true,
    "width": 320,
    "min_height": 140,
    "padding": 16,
    "overlay": "0xCC0A0A0A",
    "background": "0xE6202020",
    "border": "0xFF505050",
    "variables": {
      "title": "",
      "message": "",
      "confirm_text": "gui.yes",
      "cancel_text": "gui.cancel",
      "confirm_action": ""
    },
    "elements": [
      {
        "type": "text",
        "id": "popup_title",
        "position": { "x": "0", "y": "4" },
        "size": { "width": "screen.width", "height": "14" },
        "text": {
          "text": "{title}",
          "color": "0xFFFFFFFF",
          "shadow": true,
          "scale": 1.2
        },
        "align": "center"
      },
      {
        "type": "text",
        "id": "popup_message",
        "position": { "x": "8", "y": "28" },
        "size": { "width": "screen.width - 16", "height": "36" },
        "text": {
          "text": "{message}",
          "color": "0xFFCCCCCC",
          "scale": 1.0
        },
        "align": "center"
      },
      {
        "type": "button",
        "id": "btn_cancel",
        "position": { "x": "screen.width / 2 - 124", "y": "screen.height - 28" },
        "size": { "width": "120", "height": "22" },
        "texture": {
          "normal": "sirius_ui:buttons/default_button",
          "highlighted": "sirius_ui:buttons/default_button_highlighted"
        },
        "text": {
          "text": "{cancel_text}",
          "color": "0xFFCCCCCC"
        },
        "action": { "type": "dismiss_popup" }
      },
      {
        "type": "button",
        "id": "btn_confirm",
        "position": { "x": "screen.width / 2 + 4", "y": "screen.height - 28" },
        "size": { "width": "120", "height": "22" },
        "texture": {
          "normal": "sirius_ui:buttons/default_button",
          "highlighted": "sirius_ui:buttons/default_button_highlighted"
        },
        "text": {
          "text": "{confirm_text}",
          "color": "0xFFFF6666"
        },
        "action": { "type": "{confirm_action}" }
      }
    ]
  }
}