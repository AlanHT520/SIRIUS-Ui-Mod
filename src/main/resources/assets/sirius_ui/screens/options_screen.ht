// SIRIUS Ui - Options Screen (HT DSL v0.5.0)

// 迁移方式：ref 已内联、parent 已合并，因此本文件是自包含的；
// 想改回「模板 + 继承」写法可以随时手动重构。

screen options_screen {

    panorama = { type = "game.in_level ? vanilla : image", texture = "sirius_ui:textures/gui/images/backgrounds/background.png" };

    graphicsDraw = [
        {
            x = "0",
            y = "0",
            width = "screen.width",
            height = "28",
            color = "0xDD111111",
        },
        {
            x = "0",
            y = "27",
            width = "screen.width",
            height = "1",
            color = "0x30FFFFFF",
        },
        {
            x = "0",
            y = "28",
            width = "screen.width",
            height = "screen.height - 28",
            color = "0xBB2A2A2A",
