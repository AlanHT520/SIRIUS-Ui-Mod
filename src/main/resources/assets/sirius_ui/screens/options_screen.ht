        size = { width = "20", height = "20" };
        text = { text = " ", color = "0xFFEEEEEE", shadow = true };
        action = { type = "close_screen" };
        texture = { normal = "sirius_ui:buttons/options/back", highlighted = "sirius_ui:buttons/options/back_highlighted" };
    }
    back_button_btn.use();

