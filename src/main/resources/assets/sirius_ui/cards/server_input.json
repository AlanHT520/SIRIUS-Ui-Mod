{
  "card": {
    "type": "dialog",
    "modal": true,
    "width": 300,
    "min_height": 150,
    "padding": 10,
    "overlay": "0xCC1A1A1A",
    "background": "0xF0282828",
    "border": "0xFF555555",
    "title_bar": {
      "height": 22,
      "draggable": true,
      "background": { "color": "0xFF3A3A3A" },
      "elements": [
        {
          "type": "text",
          "position": { "x": "6", "y": "center" },
          "size": { "width": "parent.width - 28", "height": "14" },
          "text": {
            "text_key": "addServer.title",
            "color": "0xFFFFFFFF",
            "shadow": true
          }
        },
        {
          "type": "button",
          "position": { "x": "parent.width - this.width - 10", "y": "center" },
          "size": { "width": "5", "height": "5" },
          "role": "cancel",
          "style": {
            "texture": {
              "normal": "sirius_ui:buttons/options/close",
              "highlighted": "sirius_ui:buttons/options/close",
              "disabled": "sirius_ui:buttons/options/close"
            }
          }
        }
      ]
    },
    "elements": [
      {
        "type": "input_field",
        "id": "name",
        "position": { "x": "0", "y": "0" },
        "size": { "width": "parent.width", "height": "28" },
        "label": "Server Name",
        "hint": "Enter server name...",
        "max_length": 64,
        "background_color": "0xFF1A1A1A",
        "border_color": "0xFF555555",
        "focus_border_color": "0xFFAAAAAA",
        "text_color": "0xFFFFFFFF",
        "hint_color": "0xFF555555",
        "label_color": "0xFFAAAAAA"
      },
      {
        "type": "input_field",
        "id": "address",
        "position": { "x": "0", "y": "name.y + name.height + 6" },
        "size": { "width": "parent.width", "height": "28" },
        "label": "Server Address",
        "hint": "Enter server address...",
        "max_length": 128,
        "background_color": "0xFF1A1A1A",
        "border_color": "0xFF555555",
        "focus_border_color": "0xFFAAAAAA",
        "text_color": "0xFFFFFFFF",
        "hint_color": "0xFF555555",
        "label_color": "0xFFAAAAAA"
      },
      {
        "type": "button",
        "position": { "x": "parent.width / 2 - 104", "y": "address.y + address.height + 8" },
        "size": { "width": "100", "height": "20" },
        "text": {
          "text_key": "gui.cancel",
          "color": "0xFFE0E0E0",
          "shadow": true
        },
        "role": "cancel",
        "style": { "background_color": "0xFF3A3A3A" }
      },
      {
        "type": "button",
        "position": { "x": "parent.width / 2 + 4", "y": "address.y + address.height + 8" },
        "size": { "width": "100", "height": "20" },
        "text": {
          "text_key": "addServer.add",
          "color": "0xFFFFFFFF",
          "shadow": true
        },
        "action": { "type": "server_input_submit" },
        "style": { "background_color": "0xFF3A3A3A" }
      }
    ]
  }
}