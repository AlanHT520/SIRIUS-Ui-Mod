{
  "card": {
    "type": "dialog",
    "modal": true,
    "width": 260,
    "min_height": 108,
    "padding": 10,
    "data_source": "delete_confirm_info",
    "overlay": "0xCC1A1A1A",
    "background": "0xF0282828",
    "border": "0xFF555555",
    "title_bar": {
      "height": 22,
      "draggable": true,
      "background": { "color": "0xFF3A3A3A" },
      "elements": [
        {
          "type": "text",
          "position": { "x": "6", "y": "center" },
          "size": { "width": "parent.width - 28", "height": "14" },
          "text": {
            "text_key": "selectServer.delete",
            "color": "0xFFFFFFFF",
            "shadow": true
          }
        },
        {
          "type": "button",
          "position": { "x": "parent.width - this.width - 10", "y": "center" },
          "size": { "width": "5", "height": "5" },
          "role": "cancel",
          "style": {
            "texture": {
              "normal": "sirius_ui:buttons/options/close",
              "highlighted": "sirius_ui:buttons/options/close",
              "disabled": "sirius_ui:buttons/options/close"
            }
          }
        }
      ]
    },
    "elements": [
      {
        "type": "text",
        "position": { "x": "0", "y": "0" },
        "size": { "width": "parent.width", "height": "auto" },
        "text": {
          "text_key": "selectServer.deleteQuestion",
          "color": "0xFFCCCCCC",
          "shadow": false,
          "align": "center"
        }
      },
      {
        "type": "button",
        "position": { "x": "parent.width / 2 - 104", "y": "parent.height - 20" },
        "size": { "width": "100", "height": "20" },
        "text": {
          "text_key": "gui.cancel",
          "color": "0xFFE0E0E0",
          "shadow": true
        },
        "role": "cancel",
        "style": { "background_color": "0xFF3A3A3A" }
      },
      {
        "type": "button",
        "position": { "x": "parent.width / 2 + 4", "y": "parent.height - 20" },
        "size": { "width": "100", "height": "20" },
        "text": {
          "text_key": "selectServer.deleteButton",
          "color": "0xFFFF5555",
          "shadow": true
        },
        "role": "submit",
        "style": { "background_color": "0xFF3A3A3A" }
      }
    ]
  }
}