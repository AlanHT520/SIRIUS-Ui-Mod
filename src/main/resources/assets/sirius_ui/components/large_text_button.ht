// SIRIUS Ui - 大号文字按钮组件 (HT DSL v0.5.0)
//
// 用于标题界面"开始游戏"等大按钮，子文字位置略偏下（+37）。
//
// 用法：
//   import "sirius_ui:components/large_text_button.ht"
//   button xxx = large_text_button { ... }

widget button large_text_button {
    ing_duration = 2;
    variables {
        button_label = "";
        text_color = "0xFFFFFFFF";
    }
    textures {
        normal = "sirius_ui:buttons/default_button";
        highlighted = "sirius_ui:buttons/default_button_highlighted";
        disabled = "sirius_ui:buttons/default_button_disabled";
        ing = "sirius_ui:buttons/default_button_ing";
    }
    children = [
        {
            type = "text",
            text_key = "${button_label}",
            color = "${text_color}",
            position = { x = "parent.width / 2 - this.width / 2", y = "parent.height / 2 - this.height / 2 + 37" },
            shadow = true,
            state_v = {
                ing = {
                    position = { x = "parent.width / 2 - this.width / 2", y = "parent.height / 2 - this.height / 2 + 1" },
                },
                highlighted = { scale = "1.0" },
            },
        }
    ];
}