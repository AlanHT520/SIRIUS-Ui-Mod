// SIRIUS Ui - 完成按钮组件 (HT DSL v0.5.0)
//
// 完成/确认按钮（50×20），通常放右下角，点击关闭当前界面。
// 用于数据包/资源包界面。
//
// 用法：
//   import "sirius_ui:components/done_button.ht"
//   button xxx = done_button { ... }

widget button done_button {
    this.size(50, 20);
    textures {
        normal = "sirius_ui:buttons/default_button";
        highlighted = "sirius_ui:buttons/default_button_highlighted";
    }
    on clicked {
        close_screen();
    }
}