// SIRIUS Ui - 图标按钮组件 (HT DSL v0.5.0)
//
// 20×20 无文字按钮，用于标题界面左下角的语言、辅助功能等图标。
//
// 用法：
//   import "sirius_ui:components/icon_button.ht"
//   button xxx = icon_button { ... }

widget button icon_button {
    ing_duration = 2;
    variables {
        button_label = "";
        text_color = "16777088";
    }
    children = [
        {
            type = "text",
            text_key = "${button_label}",
            color = "${text_color}",
            position = { x = "parent.width / 2 - this.width / 2", y = "parent.height / 2 - this.height / 2" },
            shadow = true,
        }
    ];
}