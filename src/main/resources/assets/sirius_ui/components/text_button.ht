// SIRIUS Ui - 通用文字按钮组件 (HT DSL v0.5.0)
//
// 最常用的按钮模板，含默认纹理、ing 动画、居中文字子元素。
//
// 用法：
//   import "sirius_ui:components/text_button.ht"
//   button xxx = text_button { ... }

widget button text_button {
    ing_duration = 2;
    variables {
        button_label = "";
        text_color = "0xFFFFFFFF";
    }
    textures {
        normal = "sirius_ui:buttons/default_button";
        highlighted = "sirius_ui:buttons/default_button_highlighted";
        disabled = "sirius_ui:buttons/default_button_disabled";
        ing = "sirius_ui:buttons/default_button_ing";
    }
    children = [
        {
            type = "text",
            text_key = "${button_label}",
            color = "${text_color}",
            position = { x = "parent.width / 2 - this.width / 2", y = "parent.height / 2 - this.height / 2" },
            shadow = true,
            state_v = {
                ing = {
                    position = { x = "parent.width / 2 - this.width / 2", y = "parent.height / 2 - this.height / 2 + 1" },
                },
                highlighted = { scale = "1.0" },
            },
        }
    ];
}